// 21. Merge Two Sorted Lists

class Solution {
    public ListNode mergeTwoLists(ListNode list1, ListNode list2) {
        if (list1 == null) return list2;
        if (list2 == null) return list1;

        ListNode temp;
        if(list1.val >list2.val){
            temp = list2;
            list2 = list2.next;
        }else{
            temp = list1;
            list1 = list1.next;
        }
        ListNode ans = temp;
        ListNode h1 = list1;
        ListNode h2 = list2;
        while(h1 != null && h2 != null){
            if(h1.val > h2.val){
                temp.next = h2;
                h2= h2.next;
                temp = temp.next;
            }else{
                temp.next = h1;
                h1 = h1.next;
                temp = temp.next;
            }
        }
        if(h1==null){
            while(h2 != null){
                temp.next = h2;
                temp = temp.next;
                h2 = h2.next;
            }
        }
        if(h2==null){
            while(h1 != null){
                temp.next = h1;
                h1 = h1.next;
                temp = temp.next;
            }
        }
        return ans;
    }
}



// or 

class Solution {
    public ListNode mergeTwoLists(ListNode list1, ListNode list2) {
        if(list1 == null)return list2;
        if(list2 == null)return list1;

        if(list1.val <= list2.val){
            list1.next = mergeTwoLists(list1.next, list2);
            return list1;
        }else{
            list2.next = mergeTwoLists(list1,list2.next);
            return list2;
        }
    }
}